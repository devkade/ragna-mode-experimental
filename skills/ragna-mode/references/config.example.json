{
  "stateDir": "~/.ragna/state",
  "laneWorkspace": "lanes",
  "workspaces": [
    "lanes"
  ],
  "ignorePanes": [],
  "leadPane": "<your herdr pane id, from: herdr pane current>",
  "defaultCwd": "~/code/my-project",
  "agentCommand": [
    "omo",
    "--model",
    "{model}",
    "{prompt}"
  ],
  "defaultModel": "anthropic/claude-opus-5-5",
  "launchKeywords": "ulw set goal and work",
  "sessionsDir": "~/.omo/agent/sessions",
  "nudgeAfterMin": 15,
  "postAfterMin": 20,
  "closeAfterMin": 5,
  "heavySlots": 1,
  "heavyMaxLoad": 80,
  "deadPanePatterns": [
    "has stopped",
    "no suitable jobs"
  ],
  "guard": {
    "loadAlert": 150,
    "loadOk": 80,
    "memFreeMinPct": 20,
    "diskFreeMinGb": 50,
    "panesMax": 20
  },
  "hooks": {
    "threadReply": [
      "my-messenger",
      "reply",
      "--thread",
      "{thread}",
      "--text",
      "{text}"
    ],
    "threadDone": [
      "my-messenger",
      "set-status",
      "--thread",
      "{thread}",
      "--status",
      "done",
      "--note",
      "{text}"
    ],
    "transcribe": [
      "my-stt",
      "--file",
      "{file}"
    ]
  },
  "gateway": {
    "discord": {
      "allowedUserId": "123456789012345678",
      "allowedChannelId": "234567890123456789",
      "reply": ["agent-messenger", "discordbot", "message", "send", "{channelId}", "{text}", "--reply", "{messageId}"],
      "replyIdPath": "id"
    },
    "slack": {
      "allowedUserId": "U_REQUESTER",
      "allowedChannelId": "C_CHANNEL",
      "reply": ["agent-messenger", "slackbot", "message", "send", "{channelId}", "{text}", "--thread", "{messageId}"],
      "replyIdPath": "ts"
    },
    "telegram": {
      "allowedUserId": "123456789",
      "allowedChannelId": "-1001234567890",
      "reply": ["agent-messenger", "telegrambot", "message", "send", "{channelId}", "{text}", "--reply-to", "{messageId}"],
      "replyIdPath": "message.message_id"
    }
  },
  "gatewayModel": {
    "provider": "<provider ID from models.json>",
    "model": "<model ID from that provider>",
    "modelsPath": "~/.pi/agent/models.json"
  }
}
